# ---------------------------------------------------------------------------
# Credentials and machine-local config - NEVER commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# rclone's config holds an OAuth refresh token, which is a credential. Only the
# template is tracked.
rclone.conf
*.rclone.conf
config/rclone.conf
service-account.json
config/service-account.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Working data (directories are kept in git via .gitkeep, contents are not)
# ---------------------------------------------------------------------------
data/input/*
!data/input/.gitkeep
# Test videos are inputs the GPU runner needs, not generated artifacts.
!data/input/*.mp4

data/working/*
!data/working/.gitkeep

data/output/*
!data/output/.gitkeep

# Run directories written by `--out` (the README's `runs/<name>` example).
runs/

# ---------------------------------------------------------------------------
# Model weights and caches (downloaded at runtime, never committed)
# ---------------------------------------------------------------------------
models_cache/
models_cache/**
# A bare `models/` is not the configured cache directory (`models_cache` is), but a
# relative MODEL_CACHE_DIR - which is what a test or a quick script tends to set -
# resolves to exactly this, and a partial download landing in the tree must never be
# committable.
models/
models/**
.cache/
.huggingface/
torch_cache/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# ---------------------------------------------------------------------------
# Media and audio artifacts
# ---------------------------------------------------------------------------
# Generated audio and video never belong in git. MP4 inputs do: a small test clip
# is what scripts/test_gpu.py runs, so `data/input/*.mp4` re-includes it below.
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.mkv
*.mov
*.webm

# Native-speaker voice samples are pipeline *inputs*, not artifacts: the GPU worker
# needs them to give each character an Amharic voice instead of the film's own English
# audio, exactly as it needs the test clip above. They are a few hundred KB each. These
# negations have to come after the media block, because the last matching rule wins.
!data/voice-samples/*.mp3
!data/voice-samples/*.wav
!data/voice-samples/*.flac
!data/voice-samples/*.m4a

# A built voice bank is the opposite: a deterministic artifact of a public corpus, so
# it is rebuilt rather than committed. Keeping it out of git also keeps dataset audio
# from being redistributed through this repository; the manifest records the source,
# revision and licence, and ATTRIBUTION.md carries the credit.
data/voice-bank/

# ---------------------------------------------------------------------------
# JSON manifests generated during processing
# ---------------------------------------------------------------------------
data/**/*.json
*.diarization.json
*.transcript.json
*.amharic.json
*.dub.json

# Inputs the operator authors or supplies are not processing artifacts. The title
# file, the local transcript/cast files and the authored dialogue plan are small
# text inputs the GPU worker needs, so they are committed with the repository - the
# plan in particular is the whole point of shipping one instead of paying a model to
# write the Amharic again. These negations must stay below both `data/input/*` and
# `data/**/*.json`, because the last matching pattern wins.
!data/input/*.txt
!data/input/*.srt
!data/input/*.vtt
!data/input/*.plan.json
!data/input/*.dialogue.json
!data/input/*.cast.json
!data/input/*.characters.json
!data/input/*.character.json

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
