# ---------------------------------------------------------------------------
# Amharic dubbing pipeline - example environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Values defined here are
# placeholders only - NEVER put real secrets in this example file.
#
# See README.md ("Which variables you actually have to set") for the short
# version: HUGGINGFACE_TOKEN is required, DEEPSEEK_API_KEY is required only when
# TRANSLATION_BASE_URL points at the hosted API, and everything else has a
# working default.
# ---------------------------------------------------------------------------

# --- API credentials -------------------------------------------------------
# DeepSeek API key (dialogue adaptation / translation).
# Required only when TRANSLATION_BASE_URL points at the hosted API; leave empty
# and point that variable at a local OpenAI-compatible server to run without it.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Hugging Face token, used to download gated model weights (e.g. pyannote).
# Required by the diarization stage: pyannote Community-1 is a gated model, so
# the token's account must have accepted its conditions first.
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# --- Pipeline directories --------------------------------------------------
# Relative paths are resolved against the project root.
INPUT_DIR=./data/input
WORK_DIR=./data/working
OUTPUT_DIR=./data/output

# Model weights are downloaded here at runtime (never committed to the repo).
# `app.pipeline.tts` snapshots the Chatterbox Amharic adapter, its pinned base
# model and the adapter's loader file into this directory.
#
# Seed-VC fetches its own checkpoints, vocoder and feature extractors through
# Hugging Face's API, which takes no cache argument, so those follow HF_HOME /
# HF_HUB_CACHE instead. Export it in the worker environment (before the process
# starts - `huggingface_hub` freezes the path when it is first imported) so every
# weight ends up on the pod's persistent volume:
#   export HF_HOME=/path/to/models_cache
MODEL_CACHE_DIR=./models_cache

# --- Models ----------------------------------------------------------------
# Hugging Face pipeline id used by the diarization stage.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Optional bounds on how many speakers diarization may report. Leave empty to let
# the model decide. Supplying them - a cast count, or a generous range around one
# - is the strongest single guard against a character splitting into several
# clusters (which sounds like several different people) or merging with another.
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=

# faster-whisper model used by the transcription stage.
TRANSCRIPTION_MODEL=large-v3

# CTranslate2 compute type: `float16` on the A40 GPU, `int8` on CPU.
TRANSCRIPTION_COMPUTE_TYPE=float16

# Source language for transcription. Leave empty to detect it automatically from
# the dialogue stem; set a code such as `en` to pin it.
TRANSCRIPTION_LANGUAGE=

# --- Dialogue adaptation (translation) -------------------------------------
# Backend: `nllb` (default) translates locally with Meta's NLLB-200; `openai`
# talks to any OpenAI-compatible endpoint for instruction-following *adaptation*.
TRANSLATION_BACKEND=nllb

# The model for the selected backend. For `nllb` this is an NLLB checkpoint:
#   facebook/nllb-200-3.3B              (default: 16.4 GiB download)
#   facebook/nllb-200-distilled-1.3B    (5.1 GiB; 49.3 vs 52.2 d-chrF on Amharic)
#   facebook/nllb-200-distilled-600M    (2.3 GiB; markedly weaker)
# 3.3B is the default on measured Amharic, not on size: on AFRIDOC-MT's document-level
# metric it scores 52.2 against 49.3 for the distilled 1.3B. Every open
# instruction-following model measured on this direction trails NLLB, and the newest
# "flagship" translation models do not support Amharic at all. The 16.4 GiB is a
# one-time download that belongs on the Pod's volume.
# For `openai` it is the served model name.
TRANSLATION_MODEL=facebook/nllb-200-3.3B

# NLLB generation. 1 beam is greedy and therefore deterministic, so two runs can be
# compared; raise it when quality matters more than reproducibility.
TRANSLATION_NUM_BEAMS=1
TRANSLATION_MAX_NEW_TOKENS=512

# --- Instruction-following backend only (TRANSLATION_BACKEND=openai) --------
# OpenAI-compatible endpoint and model. Any local server works, so a self-hosted
# one (vLLM, Ollama, llama.cpp) replaces the hosted API by configuration alone:
#   TRANSLATION_BASE_URL=http://localhost:8000/v1
TRANSLATION_BASE_URL=https://api.deepseek.com
TRANSLATION_MODEL_OPENAI=deepseek-flash

# Persistent character/consistency state handed to adaptation: who the characters
# are, how they address one another, and how their recurring names and terms are
# spelled. It is what keeps a character consistent across a 90-180 minute film
# instead of being re-derived from a ten-line window, and it is meant to be
# edited by hand between runs. A missing file is an empty bible, not an error.
#   $WORK_DIR/dialogue_bible.json by default
DIALOGUE_BIBLE_PATH=./data/working/dialogue_bible.json

# How many consecutive dialogue lines are adapted in one request. Small enough
# to keep a rejection cheap, large enough to follow the conversation.
TRANSLATION_BATCH_SIZE=10

# Ask the model not to run in reasoning/thinking mode. Set to `false` if the API
# rejects the thinking toggle.
TRANSLATION_DISABLE_THINKING=true

# A line that comes back too long for its window, or with a borrowed word left in
# Roman script, is sent back once to be fixed. Both are on by default and both are
# what makes the stage self-correcting: shortening the text is how a line is made to
# fit without being stretched, and writing a borrowed word in Fidel is how it becomes
# pronounceable by an Amharic voice that reads Fidel. Set either to `false` to send
# every line exactly once - cheaper, and what a comparison run wants.
TRANSLATION_ENFORCE_BUDGET=true
TRANSLATION_ENFORCE_FIDEL_LOANWORDS=true

# --- Voice profiles --------------------------------------------------------
# Per-speaker voice identities. Relative paths are resolved against the project
# root; the default follows WORK_DIR (`$WORK_DIR/voices`). Each speaker gets
# <VOICE_PROFILE_DIR>/<SPEAKER_ID>/{reference.wav,voice_clone.pt,profile.json}.
VOICE_PROFILE_DIR=./data/working/voices

# Length of the extracted voice-cloning reference, in seconds. Voice cloning
# works from roughly 3-10 seconds, with about 10 seconds being a good target:
#   MIN      shortest window that may be accepted at all;
#   TARGET   length the selector aims for, and the score's reference point;
#   MAX      longest reference kept, and the point above which a continuous turn
#            is scanned with a sliding window instead of being used whole.
VOICE_REFERENCE_MIN_DURATION=3.0
VOICE_REFERENCE_TARGET_DURATION=10.0
VOICE_REFERENCE_MAX_DURATION=15.0

# --- Speech synthesis ------------------------------------------------------
# Engine. Each one differs in what it can be told, so the choice is really about
# which of these you need:
#
#   omnivoice  (default) k2-fsa/OmniVoice. Clones a voice from a short reference, so
#              each character keeps ONE voice for the whole film, and it accepts a
#              per-line speed request so a line can be asked for at the length its
#              window allows. ~3 GB of weights, 24 kHz. Its Amharic is supported by
#              the model (about 12.8 h of its training data) but has never been
#              evaluated, so treat its Amharic quality as unmeasured.
#   chatterbox gabar-tech/chatterbox-amharic. A LoRA adapter plus a Fidel tokenizer
#              on Chatterbox Multilingual v3, cloning from ~10 s of reference audio.
#              This is the only Amharic engine with PUBLISHED evaluation (held-out
#              character error rate 0.095, speaker similarity 0.860), so it is the
#              measured counterpart to OmniVoice's unmeasured one. Note that stock
#              Chatterbox does not read Amharic at all - the adapter is what adds the
#              244 Ge'ez tokens - and that `TTS_MODEL` is not what names it.
#   mms        facebook/mms-tts-amh. A VITS model trained on Amharic alone. It is
#              SINGLE-SPEAKER - one voice for the whole film, no cloning, no
#              per-character identity - and it needs text romanised (uroman) first.
#              Not a fit for a multi-character film; kept for a single-narrator dub.
TTS_ENGINE=omnivoice

# The model per engine. `TTS_MODEL` names the single-voice engine's checkpoint;
# the other two engines name their own.
TTS_MODEL=facebook/mms-tts-amh
CHATTERBOX_MODEL=gabar-tech/chatterbox-amharic
# OmniVoice's Amharic performance is unmeasured, which is why the base checkpoint is
# the default rather than an Amharic-only fine-tune. Worth an A/B if you want to
# compare: `african-low-resource/omnivoice-amharic` (also `Lab-et/omnivoice-amharic`,
# the same weights) was trained on far more Amharic audio, but its model card reports
# every metric as "TBD", ships no samples and names no datasets - unverified in both
# directions, not merely unproven.
OMNIVOICE_MODEL=k2-fsa/OmniVoice
# Diffusion steps. The documented faster setting is 16; 32 is the model's own default
# and the quality/speed trade is deliberately left alone here. Both sampling
# temperatures are pinned to zero in code, so a line is reproducible run to run.
OMNIVOICE_STEPS=32
OMNIVOICE_GUIDANCE_SCALE=2.0
OMNIVOICE_TORCH_DTYPE=float16

# VITS samples its rhythm, so generation is seeded: without a fixed seed the same
# line would come out a different length every run, and a baseline would be
# meaningless. The rate reaches the duration predictor *before* synthesis, so the
# model is asked for a duration instead of the audio being stretched to reach one.
# It applies to the whole film, not line by line: 1.2 makes every line about 16%
# shorter, and each line is still fitted to its own window by the timing stage.
# (`mms` only: OmniVoice takes its rate per line on the generate call.)
MMS_SEED=0
MMS_SPEAKING_RATE=1.0

# Ask a cloning engine for a per-line length, based on the line's syllable count and
# its own window, before the timing stage falls back to stretching. Asking a model for
# a duration changes how the line is *spoken*; time-stretching changes audio that has
# already been spoken. Two levels are used, not one: one film-wide delivery rate
# absorbs the systematic difference between Amharic and English, and each line is then
# corrected only slightly around it, so the pacing stays even across the film. Turn
# this off to attribute a difference to it in a comparison.
TTS_REQUEST_RATE=true

# Seed-VC is not a package: clone it and point this at the checkout. The TTS
# stage runs `configs/v2/vc_wrapper.yaml` from there for the identity step.
#   git clone https://github.com/Plachtaa/seed-vc <SEED_VC_REPO_PATH>
# Upstream is read-only since April 2025, so pin a known-good commit and keep it:
#   git -C <SEED_VC_REPO_PATH> checkout <commit>
# Each run records the revision in the manifest (`provenance.seed_vc_revision`).
SEED_VC_REPO_PATH=./models_cache/seed-vc
# Diffusion steps of the Seed-VC V2 converter; 30 is the V2 script's default.
SEED_VC_DIFFUSION_STEPS=30

# Whether Seed-VC V2 also converts the *reference's* accent and style, on top of
# its timbre. Keep this `false`, which is the default: Seed-VC's style branch
# conditions its autoregressive stage on the reference's acoustic tokens and
# content indices, so it speaks the take in the reference's accent and emotion.
# The character reference is the original actor's English audio, so switching it
# on would re-impose an English accent on the Amharic and overwrite the
# performance the Chatterbox prompt carried over. Set `true` only for a single
# controlled A/B comparison.
SEED_VC_CONVERT_STYLE=false

# Length of the original-performance prompt taken from the clean BandIt speech
# stem and handed to Chatterbox, in seconds. A shorter line is padded with its
# own surrounding dialogue, a longer one is trimmed, both around the line.
TTS_PERFORMANCE_REFERENCE_MIN_DURATION=6.0
TTS_PERFORMANCE_REFERENCE_MAX_DURATION=12.0

# Longest pause rendered before/after a line from the dialogue model's
# pause_before/pause_after estimate, in seconds.
TTS_MAX_PAUSE_SECONDS=2.0

# Shortest original window that can be dubbed, in seconds. Below this the original
# is a fragment rather than a spoken line - a breath, a click, a sliver of a
# mis-diarized turn - so there is no room for a word in the time it occupied, and
# the speech engine can fail outright on it (Chatterbox does, with an empty mel
# spectrogram that trips a convolution inside its vocoder). Such lines are skipped
# and reported rather than attempted, and the lines around them are unaffected.
TTS_MIN_LINE_SECONDS=0.30

# Skip and report a line an engine *fails* on, instead of ending the run. Off by
# default, because hiding a failure is worse than stopping: a stage error names the
# line. Turn it on for a long film when finishing matters more than a complete first
# pass. Either way the skipped lines and their reasons are recorded in the manifest.
TTS_CONTINUE_ON_FAILURE=false

# --- Timing alignment ------------------------------------------------------
# How far a line's delivery may be time-stretched to fit the window of the line
# it replaces, as a tempo factor: below 1 slows the line down, above 1 speeds it
# up, and both preserve pitch. The band is deliberately narrow - a line that
# needs more than a quarter faster or a fifth slower is reported as not fitting
# rather than mangled to fit. FFmpeg's `atempo` filter supports 0.5-2.0, so a
# wider band is rejected rather than passed through.
TIMING_MIN_TEMPO=0.80
TIMING_MAX_TEMPO=1.25

# --- Final mix -------------------------------------------------------------
# Level of the dubbed dialogue in the final mix, in dB relative to the clips the
# TTS stage produced. Signed: 0 leaves the dialogue as generated, a negative
# value attenuates it. A boost is not recommended - it only invites clipping.
MIX_DIALOGUE_GAIN_DB=0.0

# How far the music and effects are ducked while dialogue is playing, in dB.
# The reduction is ramped, so it follows the dialogue instead of gating it, and
# it is applied to the music/effects bed only - never to the dialogue.
MIX_DUCK_DB=6.0

# --- Runtime behaviour -----------------------------------------------------
# Compute device hint: `cuda` on the GPU worker, `cpu` for CPU-only checks.
DEVICE=cuda

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
